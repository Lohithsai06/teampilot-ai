rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────

    // Is the request from a signed-in user?
    function isAuth() {
      return request.auth != null;
    }

    // Is the signed-in user the leader of this project?
    function isLeader(projectId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/projectMembers/$(projectId + "_" + request.auth.uid)) &&
        get(/databases/$(database)/documents/projectMembers/$(projectId + "_" + request.auth.uid)).data.role == "leader";
    }

    // Is the signed-in user a member of this project?
    function isMember(projectId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/projectMembers/$(projectId + "_" + request.auth.uid));
    }

    // ─── projects ────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      // Any signed-in user can read a project they are a member of
      allow read: if isMember(projectId);

      // Any signed-in user can query projects (needed for "in" queries in ProjectContext)
      // Reads on the collection level (list) are allowed for authenticated users;
      // the query itself must include a where("projectId","in", [...]) filter.
      allow list: if isAuth();

      // Only authenticated users can create a project (they will be set as leader)
      allow create: if isAuth()
        && request.resource.data.leaderId == request.auth.uid;

      // Only the project leader can update or delete the project
      allow update, delete: if isLeader(projectId);
    }

    // ─── projectMembers ──────────────────────────────────────────────────────
    // Document ID format: {projectId}_{userId}
    match /projectMembers/{memberDocId} {
      // Any authenticated user can read membership records
      // (needed to check "is this user already a member?")
      allow read: if isAuth();

      // Only authenticated users can create their own membership record,
      // OR a project leader can create a membership record (approve request)
      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid ||
        isLeader(request.resource.data.projectId)
      );

      // Only the project leader can update or remove member records
      allow update, delete: if isAuth() &&
        isLeader(resource.data.projectId);
    }

    // ─── joinRequests ────────────────────────────────────────────────────────
    // Document ID format: {projectId}_{userId}
    match /joinRequests/{requestId} {
      // A user can read their own request;
      // a project leader can read requests for their projects
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isLeader(resource.data.projectId)
      );

      // Any authenticated user can create a join request for themselves
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending";

      // Only the project leader can delete (approve/reject) a join request
      allow delete: if isAuth() && isLeader(resource.data.projectId);

      // Status updates are handled by delete + create (no update needed)
      allow update: if false;
    }
  }
}
