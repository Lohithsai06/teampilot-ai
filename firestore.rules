rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────

    // Is the request from a signed-in user?
    function isAuth() {
      return request.auth != null;
    }

    // Is the signed-in user the leader of this project?
    function isLeader(projectId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/projectMembers/$(projectId + "_" + request.auth.uid)) &&
        get(/databases/$(database)/documents/projectMembers/$(projectId + "_" + request.auth.uid)).data.role == "leader";
    }

    // Is the signed-in user a member of this project?
    function isMember(projectId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/projectMembers/$(projectId + "_" + request.auth.uid));
    }

    // ─── projects ────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if isMember(projectId);
      allow list: if isAuth();
      allow create: if isAuth()
        && request.resource.data.leaderId == request.auth.uid;
      allow update: if isMember(projectId);
      allow delete: if isLeader(projectId);
    }

    // ─── projectMembers ──────────────────────────────────────────────────────
    // Document ID format: {projectId}_{userId}
    match /projectMembers/{memberDocId} {
      allow read: if isAuth();
      allow list: if isAuth();
      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid ||
        isLeader(request.resource.data.projectId)
      );
      allow update, delete: if isAuth() &&
        isLeader(resource.data.projectId);
    }

    // ─── joinRequests ────────────────────────────────────────────────────────
    // Document ID format: {projectId}_{userId}
    match /joinRequests/{requestId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isLeader(resource.data.projectId)
      );
      allow list: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending";
      allow delete: if isAuth() && isLeader(resource.data.projectId);
      allow update: if false;
    }

    // ─── users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // ─── roadmaps ──────────────────────────────────────────────────────────
    // AI-generated project roadmaps. One active roadmap per project.
    match /roadmaps/{roadmapId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth()
        && request.resource.data.generatedBy == request.auth.uid
        && isMember(request.resource.data.projectId);
      allow update: if isAuth()
        && isMember(resource.data.projectId);
      allow delete: if isAuth()
        && isLeader(resource.data.projectId);
    }

    // ─── roadmapPhases ────────────────────────────────────────────────────
    // Individual phases within a roadmap.
    match /roadmapPhases/{phaseId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth()
        && isMember(request.resource.data.projectId);
      allow update: if isAuth()
        && isMember(resource.data.projectId);
      allow delete: if isAuth()
        && isLeader(resource.data.projectId);
    }

    // ─── aiChats ─────────────────────────────────────────────────────────────
    // Chat messages for a project. Both user messages and AI assistant responses
    // are written by the signed-in user (userId = request.auth.uid for both),
    // distinguished by the `role` field ("user" | "assistant").
    match /aiChats/{chatId} {
      // Allow reading a single document if the reader is a project member
      allow get: if isAuth() && isMember(resource.data.projectId);

      // Allow listing/querying — used by onSnapshot realtime listeners.
      // Any authenticated user can list; the query's where("projectId","==",...)
      // filter ensures they only see messages for projects they belong to.
      allow list: if isAuth();

      // Any project member can create a chat message (user or AI response).
      // The userId field must match the signed-in user for both user and
      // assistant messages (the role field distinguishes them, not userId).
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && isMember(request.resource.data.projectId);

      // Messages are immutable
      allow update, delete: if false;
    }

    // ─── githubRepositories ──────────────────────────────────────────────────
    match /githubRepositories/{repoId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth() && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && isMember(resource.data.projectId);
    }

    // ─── githubActivity ──────────────────────────────────────────────────────
    match /githubActivity/{activityId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth() && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && isMember(resource.data.projectId);
    }

    // ─── githubReports ───────────────────────────────────────────────────────
    match /githubReports/{reportId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth() && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && isMember(resource.data.projectId);
    }

    // ─── tasks ───────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth() && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && isMember(resource.data.projectId);
    }

    // ─── agentSessions ───────────────────────────────────────────────────────
    match /agentSessions/{sessionId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth() && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && isMember(resource.data.projectId);
    }

    // ─── generatedPrompts ────────────────────────────────────────────────────
    match /generatedPrompts/{promptId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth() && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && isMember(resource.data.projectId);
    }
  }
}
