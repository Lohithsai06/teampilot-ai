rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ─────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isLeader(projectId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/projectMembers/$(projectId + "_" + request.auth.uid)) &&
        get(/databases/$(database)/documents/projectMembers/$(projectId + "_" + request.auth.uid)).data.role == "leader";
    }

    function isMember(projectId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/projectMembers/$(projectId + "_" + request.auth.uid));
    }

    // ─── projects ─────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if isMember(projectId);
      allow list: if isAuth();
      allow create: if isAuth() && request.resource.data.leaderId == request.auth.uid;
      allow update: if isMember(projectId);
      allow delete: if isLeader(projectId);
    }

    // ─── projectMembers ───────────────────────────────────────────────────────
    match /projectMembers/{memberDocId} {
      allow read: if isAuth();
      allow list: if isAuth();
      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid ||
        isLeader(request.resource.data.projectId)
      );
      allow update, delete: if isAuth() && isLeader(resource.data.projectId);
    }

    // ─── joinRequests ─────────────────────────────────────────────────────────
    match /joinRequests/{requestId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isLeader(resource.data.projectId)
      );
      allow list: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending";
      allow delete: if isAuth() && isLeader(resource.data.projectId);
      allow update: if false;
    }

    // ─── users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // ─── aiChats ──────────────────────────────────────────────────────────────
    match /aiChats/{chatId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && isMember(request.resource.data.projectId);
      allow update, delete: if false;
    }

    // ─── roadmaps ─────────────────────────────────────────────────────────────
    match /roadmaps/{roadmapId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth()
        && request.resource.data.generatedBy == request.auth.uid
        && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && isLeader(resource.data.projectId);
    }

    // ─── roadmapPhases ────────────────────────────────────────────────────────
    match /roadmapPhases/{phaseId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth() && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && isLeader(resource.data.projectId);
    }

    // ─── chatRooms ────────────────────────────────────────────────────────────
    match /chatRooms/{roomId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth() && isMember(request.resource.data.projectId);
      allow update, delete: if isAuth() && isLeader(resource.data.projectId);
    }

    // ─── messages (team chat) ─────────────────────────────────────────────────
    match /messages/{messageId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid
        && isMember(request.resource.data.projectId);
      allow update: if isAuth()
        && resource.data.senderId == request.auth.uid
        && isMember(resource.data.projectId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["message", "edited", "editedAt", "mentions"]);
      allow delete: if isAuth()
        && isMember(resource.data.projectId)
        && (resource.data.senderId == request.auth.uid || isLeader(resource.data.projectId));
    }

    // ─── typingStatus ─────────────────────────────────────────────────────────
    match /typingStatus/{typingId} {
      allow list: if isAuth();
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow create, update: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && isMember(request.resource.data.projectId);
      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid
        && isMember(resource.data.projectId);
    }

    // ─── chatPresence ─────────────────────────────────────────────────────────
    match /chatPresence/{presenceId} {
      allow list: if isAuth();
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow create, update: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && isMember(request.resource.data.projectId);
      allow delete: if false;
    }

    // ─── notifications ────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow list: if isAuth();
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow create: if isAuth() && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && isLeader(resource.data.projectId);
    }

    // ─── meetings ─────────────────────────────────────────────────────────────
    match /meetings/{meetingDocId} {
      allow list: if isAuth();
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow create: if isAuth()
        && request.resource.data.createdBy == request.auth.uid
        && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && (
        isLeader(resource.data.projectId) ||
        resource.data.createdBy == request.auth.uid
      );
    }

    // ─── meetingHistory ───────────────────────────────────────────────────────
    match /meetingHistory/{histId} {
      allow list, get: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ─── meetingCandidates ────────────────────────────────────────────────────
    match /meetingCandidates/{candidateId} {
      allow read, list: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── githubRepositories ───────────────────────────────────────────────────
    match /githubRepositories/{repoId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth() && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && isMember(resource.data.projectId);
    }

    // ─── githubReports ────────────────────────────────────────────────────────
    match /githubReports/{reportId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth() && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && isMember(resource.data.projectId);
    }

    // ─── tasks ────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth() && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && isMember(resource.data.projectId);
    }

    // ─── agentSessions ────────────────────────────────────────────────────────
    match /agentSessions/{sessionId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth() && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && isMember(resource.data.projectId);
    }

    // ─── generatedPrompts ─────────────────────────────────────────────────────
    match /generatedPrompts/{promptId} {
      allow get: if isAuth() && isMember(resource.data.projectId);
      allow list: if isAuth();
      allow create: if isAuth() && isMember(request.resource.data.projectId);
      allow update: if isAuth() && isMember(resource.data.projectId);
      allow delete: if isAuth() && isMember(resource.data.projectId);
    }
  }
}
